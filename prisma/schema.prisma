// Learning Navigator — persistence layer (PostgreSQL / Supabase via Prisma).
// Deliberately minimal: 4 dynamic tables + 1 singleton AI config row.
// Static catalog (skills / roles / resources / quizzes) lives in code, not the DB.
//
// Multi-goal: one LearnerProfile row IS one route (its own goal, roadmap
// versions, step states, events). `ownerId` links routes to a Supabase Auth
// user; null = anonymous guest route or demo persona.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer) — used at runtime
  directUrl = env("DIRECT_URL")   // direct/session — used for migrations
}

model LearnerProfile {
  id              String   @id @default(cuid())
  name            String
  targetRole      String
  goalText        String   @default("")
  experienceLevel String   @default("beginner") // beginner | intermediate | advanced
  learningStyle   String   @default("mixed")     // video | reading | project | mixed
  weeklyHours     Int      @default(8)
  timelineWeeks   Int      @default(24)
  careerOutcome   String   @default("")
  interests       String   @default("[]") // JSON string[]
  knownSkills     String   @default("[]") // JSON {skillId, proficiency}[]
  preferences     String   @default("{}") // JSON object (weights, biases)
  // Supabase Auth user id when this route belongs to an account; null = guest.
  ownerId         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  paths  LearningPath[]
  steps  StepState[]
  events Event[]

  @@index([ownerId])
}

model LearningPath {
  id        String   @id @default(cuid())
  profileId String
  version   Int
  phases    String   @default("[]") // JSON Phase[]
  rationale String   @default("{}") // JSON generation rationale
  createdAt DateTime @default(now())

  profile LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model StepState {
  id        String   @id @default(cuid())
  profileId String
  stepId    String
  status    String   @default("locked") // locked | available | in_progress | completed | skipped
  score     Int?
  updatedAt DateTime @updatedAt

  profile LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, stepId])
  @@index([profileId])
}

model Event {
  id        String   @id @default(cuid())
  profileId String
  type      String // completion | assessment | feedback | adaptation | time_change | goal_change | profile_created
  payload   String   @default("{}") // JSON
  createdAt DateTime @default(now())

  profile LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

// Per-session (or per-user) runtime AI configuration. The row id is the
// anonymous browser session id (ai_sid cookie) for guests, or "u-<auth user
// id>" once authenticated — so a saved key persists with the account across
// devices but is still never global and never shared between users.
// API key is stored server-side ONLY and never returned to the browser
// un-masked. There is deliberately NO global row: one visitor's key must
// never become another visitor's provider.
model AiConfig {
  id        String   @id @default("singleton")
  provider  String   @default("")
  model     String   @default("")
  apiKey    String   @default("")
  mode      String   @default("hybrid")
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
