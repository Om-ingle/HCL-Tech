# ── Learning Navigator — environment configuration ───────────────────────────
# Copy to .env and fill in as needed. The app runs fully WITHOUT any AI keys
# (Demo/Fallback mode). AI provider config is set at runtime in the in-app
# "AI Settings" panel and stored server-side per session/user — never in env.

# ── Database (Supabase Postgres) ──────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string.
# DATABASE_URL = "Transaction pooler" (port 6543). Append ?pgbouncer=true&connection_limit=1
# DIRECT_URL   = "Session pooler"     (port 5432). Used by Prisma for migrations.
# If your password contains @ : / ? # etc., percent-encode it (@ → %40).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── Accounts (Supabase Auth) ─────────────────────────────────────────────────
# Optional: email/password accounts so routes persist across devices. When
# these are unset, all auth UI is hidden and the app is guest-only.
# Supabase → Project Settings → API. The anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ── Optional external resource search (off by default) ───────────────────────
# SEARCH_PROVIDER=tavily
# SEARCH_API_KEY=

# NOTE: LLM_PROVIDER / LLM_MODEL / LLM_API_KEY / AI_MODE are NOT read by the
# app (kept here only as historical reference) — runtime AI config lives in
# the AiConfig table, scoped per browser session or per signed-in user.
